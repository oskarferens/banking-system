# Optional overrides for Docker Compose. Copy this file to .env (ignored by Git) and edit as needed.
# Each value has a development default in docker-compose.yml.

# NOTE: MySQL only applies these values when initializing the data volume.
# After changing them, reset the database with: docker compose down -v
#MYSQL_ROOT_PASSWORD=root
#DB_USER=banking
#DB_PASSWORD=banking

# 64 hexadecimal characters (32 random bytes). Generate your own; do not use the default from docker-compose.yml.
#JWT_SECRET=